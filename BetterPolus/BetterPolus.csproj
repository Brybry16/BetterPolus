<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <VersionPrefix>2026.11.6</VersionPrefix>
        <VersionSuffix Condition="'$(Configuration)' == 'Debug'">dev</VersionSuffix>
        <Authors>Brybry</Authors>
        <RepositoryType>git</RepositoryType>

        <NoWarn>$(NoWarn);CS0436</NoWarn>

        <TargetFramework>net6.0</TargetFramework>
        <LangVersion>preview</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <DebugType>embedded</DebugType>
        <DebugSymbols>true</DebugSymbols>
        <Configurations>Debug;Release</Configurations>
        <Platforms>BetterPolus</Platforms>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AmongUs.GameLibs.Steam" Version="2026.9.29" />
        <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.735" />

        <PackageReference Include="BepInEx.AutoPlugin" Version="1.1.0" PrivateAssets="all" />
        <PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.1.0-rc.1" PrivateAssets="all" />
        <PackageReference Include="JetBrains.Annotations" Version="2025.2.2" Aliases="JetBrains" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Unity.Analyzers" Version="1.28.0" PrivateAssets="all" />
    </ItemGroup>
</Project>